-- R(A), ... = R(A)(R(A+1), ...): B - 1 arguments, or up to top when B is 0; C - 1 results, or all of them (setting top) when C is 0.
const function MakeCallN(Mode: number, A: number, B: number, C: number, OnNext: Handler, OnTarget: Handler): (Handler, Linker)
	local NextFn: Handler = OnNext

	const function Link(LinkedNext: Handler, LinkedTarget: Handler)
		NextFn = LinkedNext
	end

	const SlotA = A + RegisterBase + 1

	if Mode == 1 then --// chained
		return function(Stack: Registers): Handler?
			const Params = if B == 0 then Stack[5] - SlotA else B - 1
			const Results = TablePack(Stack[SlotA](TableUnpack(Stack, SlotA + 1, SlotA + Params)))
			local ResultCount = Results.n

			if C == 0 then
				Stack[5] = SlotA + ResultCount - 1
			else
				ResultCount = C - 1
			end

			TableMove(Results, 1, ResultCount, SlotA, Stack)

			return OnNext(Stack)
		end, Unlinked
	end

	return function(Stack: Registers): Handler?
		const Params = if B == 0 then Stack[5] - SlotA else B - 1
		const Results = TablePack(Stack[SlotA](TableUnpack(Stack, SlotA + 1, SlotA + Params)))
		local ResultCount = Results.n

		if C == 0 then
			Stack[5] = SlotA + ResultCount - 1
		else
			ResultCount = C - 1
		end

		TableMove(Results, 1, ResultCount, SlotA, Stack)

		return NextFn
	end, Link
end

