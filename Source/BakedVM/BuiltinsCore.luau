const function Matches(Id: number, Value: any, Count: number, Results: number): boolean
	--// a builtin missing from the host (the integer library on Roblox) proves nothing
	if Value == nil then
		return false
	end

	if Id == 1 then
		return (Value == Assert) and (Count == 1 or Count == 2) and Results <= 1
	end

	if Id == 40 then
		return (Value == Type) and (Count == 1) and Results <= 1
	end

	if Id == 41 then
		return (Value == StringByte) and (Count == 1 or Count == 2 or Count == 3) and Results <= 1
	end

	if Id == 42 then
		return (Value == StringChar) and (Count == 1 or Count == 2 or Count == 3) and Results <= 1
	end

	if Id == 43 then
		return (Value == StringLen) and (Count == 1) and Results <= 1
	end

	if Id == 44 then
		return (Value == Typeof) and (Count == 1) and Results <= 1
	end

	if Id == 45 then
		return (Value == StringSub) and (Count == 2 or Count == 3) and Results <= 1
	end

	if Id == 49 then
		return (Value == Rawset) and (Count == 3) and Results <= 1
	end

	if Id == 50 then
		return (Value == Rawget) and (Count == 2) and Results <= 1
	end

	if Id == 51 then
		return (Value == Rawequal) and (Count == 2) and Results <= 1
	end

	if Id == 52 then
		return (Value == TableInsert) and (Count == 2 or Count == 3) and Results == 0
	end

	if Id == 58 then
		return (Value == Rawlen) and (Count == 1) and Results <= 1
	end

	if Id == 60 then
		return (Value == Getmetatable) and (Count == 1) and Results <= 1
	end

	if Id == 62 then
		return (Value == Tonumber) and (Count == 1 or Count == 2) and Results <= 1
	end

	if Id == 63 then
		return (Value == Tostring) and (Count == 1) and Results <= 1
	end

	return false
end

