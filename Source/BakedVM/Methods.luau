		const Object = Stack[SlotB]
		const Found = Object[Method]

		if Found == nil then
			Error(`attempt to call missing method '{Method}' of {Typeof(Object)}`)
		end

		Spread(Stack, SlotA, Found(Object, Stack[SlotA + 2], Stack[SlotA + 3], Stack[SlotA + 4], Stack[SlotA + 5]))

		return NextFn
	end, Link
end

