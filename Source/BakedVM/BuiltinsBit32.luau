const function Matches(Id: number, Value: any, Count: number, Results: number): boolean
	if Id == 28 then
		return (Value == Bit32Arshift) and (Count == 2) and Results <= 1
	end

	if Id == 29 then
		return (Value == Bit32Band) and (Count == 1 or Count == 2 or Count == 3) and Results <= 1
	end

	if Id == 30 then
		return (Value == Bit32Bnot) and (Count == 1) and Results <= 1
	end

	if Id == 31 then
		return (Value == Bit32Bor) and (Count == 2 or Count == 3) and Results <= 1
	end

	if Id == 32 then
		return (Value == Bit32Bxor) and (Count == 2 or Count == 3) and Results <= 1
	end

	if Id == 33 then
		return (Value == Bit32Btest) and (Count == 2) and Results <= 1
	end

	if Id == 34 then
		return (Value == Bit32Extract) and (Count == 2 or Count == 3) and Results <= 1
	end

	if Id == 35 then
		return (Value == Bit32Lrotate) and (Count == 2) and Results <= 1
	end

	if Id == 36 then
		return (Value == Bit32Lshift) and (Count == 2) and Results <= 1
	end

	if Id == 37 then
		return (Value == Bit32Replace) and (Count == 3 or Count == 4) and Results <= 1
	end

	if Id == 38 then
		return (Value == Bit32Rrotate) and (Count == 2) and Results <= 1
	end

	if Id == 39 then
		return (Value == Bit32Rshift) and (Count == 2) and Results <= 1
	end

	if Id == 55 then
		return (Value == Bit32Countlz) and (Count == 1) and Results <= 1
	end

	if Id == 56 then
		return (Value == Bit32Countrz) and (Count == 1) and Results <= 1
	end

	if Id == 59 then
		return (Value == Bit32Extract) and (Count == 2 or Count == 3) and Results <= 1
	end

	if Id == 64 then
		return (Value == Bit32Byteswap) and (Count == 1) and Results <= 1
	end

	return false
end

