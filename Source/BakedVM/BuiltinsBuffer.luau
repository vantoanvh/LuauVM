const function Matches(Id: number, Value: any, Count: number, Results: number): boolean
	if Id == 65 then
		return (Value == BufferReadi8) and (Count == 2) and Results <= 1
	end

	if Id == 66 then
		return (Value == BufferReadu8) and (Count == 2) and Results <= 1
	end

	if Id == 67 then
		return (Value == BufferWriteu8 or Value == BufferWritei8) and (Count == 3) and Results == 0
	end

	if Id == 68 then
		return (Value == BufferReadi16) and (Count == 2) and Results <= 1
	end

	if Id == 69 then
		return (Value == BufferReadu16) and (Count == 2) and Results <= 1
	end

	if Id == 70 then
		return (Value == BufferWriteu16 or Value == BufferWritei16) and (Count == 3) and Results == 0
	end

	if Id == 71 then
		return (Value == BufferReadi32) and (Count == 2) and Results <= 1
	end

	if Id == 72 then
		return (Value == BufferReadu32) and (Count == 2) and Results <= 1
	end

	if Id == 73 then
		return (Value == BufferWriteu32 or Value == BufferWritei32) and (Count == 3) and Results == 0
	end

	if Id == 74 then
		return (Value == BufferReadf32) and (Count == 2) and Results <= 1
	end

	if Id == 75 then
		return (Value == BufferWritef32) and (Count == 3) and Results == 0
	end

	if Id == 76 then
		return (Value == BufferReadf64) and (Count == 2) and Results <= 1
	end

	if Id == 77 then
		return (Value == BufferWritef64) and (Count == 3) and Results == 0
	end

	if Id == 131 then
		return (Value == BufferReadinteger) and (Count == 2) and Results <= 1
	end

	if Id == 132 then
