				return OnNext(Stack)
			end

			return OnTarget(Stack)
		end, Unlinked
	end

	if Mode == 2 then --// branch chained
		return function(Stack: Registers): Handler?
			local Limit = Stack[SlotA]
			local Step = Stack[SlotA + 1]
			local Index = Stack[SlotA + 2]

			if Type(Index) ~= "number" then
				Index = Tonumber(Index)

				if Index == nil then
					Error(`invalid 'for' initial value (number expected, got {Type(Stack[SlotA + 2])})`)
				end

				Stack[SlotA + 2] = Index
			end

			if Type(Limit) ~= "number" then
				Limit = Tonumber(Limit)

				if Limit == nil then
					Error(`invalid 'for' limit (number expected, got {Type(Stack[SlotA])})`)
				end

				Stack[SlotA] = Limit
			end

			if Type(Step) ~= "number" then
				Step = Tonumber(Step)

				if Step == nil then
					Error(`invalid 'for' step (number expected, got {Type(Stack[SlotA + 1])})`)
				end

				Stack[SlotA + 1] = Step
			end

			if Step > 0 then
				if Index <= Limit then
					return NextFn
				end
			elseif Limit <= Index then
				return NextFn
			end

			return OnTarget(Stack)
		end, Link
	end

	if Mode == 1 then --// fallthrough chained
		return function(Stack: Registers): Handler?
			local Limit = Stack[SlotA]
			local Step = Stack[SlotA + 1]
			local Index = Stack[SlotA + 2]

			if Type(Index) ~= "number" then
				Index = Tonumber(Index)

				if Index == nil then
					Error(`invalid 'for' initial value (number expected, got {Type(Stack[SlotA + 2])})`)
				end

				Stack[SlotA + 2] = Index
			end

			if Type(Limit) ~= "number" then
				Limit = Tonumber(Limit)

				if Limit == nil then
					Error(`invalid 'for' limit (number expected, got {Type(Stack[SlotA])})`)
				end

				Stack[SlotA] = Limit
			end

			if Type(Step) ~= "number" then
				Step = Tonumber(Step)

				if Step == nil then
					Error(`invalid 'for' step (number expected, got {Type(Stack[SlotA + 1])})`)
				end

				Stack[SlotA + 1] = Step
			end

			if Step > 0 then
				if Index <= Limit then
					return OnNext(Stack)
				end
			elseif Limit <= Index then
				return OnNext(Stack)
			end

			return TargetFn
		end, Link
	end

	return function(Stack: Registers): Handler?
		local Limit = Stack[SlotA]
		local Step = Stack[SlotA + 1]
		local Index = Stack[SlotA + 2]

		if Type(Index) ~= "number" then
			Index = Tonumber(Index)

			if Index == nil then
				Error(`invalid 'for' initial value (number expected, got {Type(Stack[SlotA + 2])})`)
			end

			Stack[SlotA + 2] = Index
		end

		if Type(Limit) ~= "number" then
			Limit = Tonumber(Limit)

			if Limit == nil then
				Error(`invalid 'for' limit (number expected, got {Type(Stack[SlotA])})`)
			end

			Stack[SlotA] = Limit
		end

		if Type(Step) ~= "number" then
			Step = Tonumber(Step)

			if Step == nil then
				Error(`invalid 'for' step (number expected, got {Type(Stack[SlotA + 1])})`)
			end

			Stack[SlotA + 1] = Step
		end

		if Step > 0 then
			if Index <= Limit then
				return NextFn
			end
		elseif Limit <= Index then
			return NextFn
		end

		return TargetFn
	end, Link
end

local ForNLoopMaker: ((Mode: number, A: number, OnNext: Handler, OnTarget: Handler) -> (Handler, Linker))? = nil

const function LoadForNLoop(): (Mode: number, A: number, OnNext: Handler, OnTarget: Handler) -> (Handler, Linker)
	const Maker = ForNLoopMaker or require("./Variants/Control/ForNPrepThroughForNLoopStepOneLimit").MakeForNLoop

	ForNLoopMaker = Maker

	return Maker
end

-- R(A+2) += R(A+1), then jump back while R(A+2) is within limit R(A).
-- Baked copies (A < 32) load from Variants/Control on first use; other operands run the generic copy below.
const function MakeForNLoop(Mode: number, A: number, OnNext: Handler, OnTarget: Handler): (Handler, Linker)
	if Mode == 1 and A < 32 then
		return LoadForNLoop()(Mode, A, OnNext, OnTarget)
	end

	local NextFn: Handler = OnNext
	local TargetFn: Handler = OnTarget

	const function Link(LinkedNext: Handler, LinkedTarget: Handler)
		NextFn = LinkedNext
		TargetFn = LinkedTarget
	end

	const SlotA = A + RegisterBase + 1

	if Mode == 1 then --// fallthrough chained
		return function(Stack: Registers): Handler?
			const Step = Stack[SlotA + 1]
			const Index = Stack[SlotA + 2] + Step

			Stack[SlotA + 2] = Index

			if Step > 0 then
				if Index <= Stack[SlotA] then
					return TargetFn
				end
			elseif Stack[SlotA] <= Index then
				return TargetFn
			end

			return OnNext(Stack)
		end, Link
	end

	return function(Stack: Registers): Handler?
		const Step = Stack[SlotA + 1]
		const Index = Stack[SlotA + 2] + Step

		Stack[SlotA + 2] = Index

		if Step > 0 then
			if Index <= Stack[SlotA] then
				return TargetFn
			end
		elseif Stack[SlotA] <= Index then
			return TargetFn
		end

		return NextFn
	end, Link
end

