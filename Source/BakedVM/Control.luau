-- R(A+3), ... = Count values of R(A)(R(A+1), R(A+2)), then jump back unless R(A+3) is nil.
const function MakeForGLoopN(Mode: number, A: number, Count: number, OnNext: Handler, OnTarget: Handler): (Handler, Linker)
	local NextFn: Handler = OnNext
	local TargetFn: Handler = OnTarget

	const function Link(LinkedNext: Handler, LinkedTarget: Handler)
		NextFn = LinkedNext
		TargetFn = LinkedTarget
	end

	const SlotA = A + RegisterBase + 1

	if Mode == 1 then --// fallthrough chained
		return function(Stack: Registers): Handler?
			const Values = TablePack(Stack[SlotA](Stack[SlotA + 1], Stack[SlotA + 2]))

			TableMove(Values, 1, Count, SlotA + 3, Stack)

			if Stack[SlotA + 3] ~= nil then
				Stack[SlotA + 2] = Stack[SlotA + 3]

				return TargetFn
			end

			return OnNext(Stack)
		end, Link
	end

	return function(Stack: Registers): Handler?
		const Values = TablePack(Stack[SlotA](Stack[SlotA + 1], Stack[SlotA + 2]))

		TableMove(Values, 1, Count, SlotA + 3, Stack)

		if Stack[SlotA + 3] ~= nil then
			Stack[SlotA + 2] = Stack[SlotA + 3]

			return TargetFn
		end

		return NextFn
	end, Link
end

