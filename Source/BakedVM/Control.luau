-- Generic for setup over R(A): functions run as is, tables iterate by __iter or next.
const function MakeForGPrep(Mode: number, A: number, Strict: boolean, OnNext: Handler, OnTarget: Handler): (Handler, Linker)
	local NextFn: Handler = OnNext

	const function Link(LinkedNext: Handler, LinkedTarget: Handler)
		NextFn = LinkedNext
	end

	const SlotA = A + RegisterBase + 1

	if Mode == 1 then --// chained
		return function(Stack: Registers): Handler?
			const Iterator = Stack[SlotA]
			const Kind = Type(Iterator)

			if Kind == "function" then
				return OnNext(Stack)
			end

			if Strict then
				Error(`attempt to iterate over a {Kind} value`)
			end

			if Kind == "table" or Kind == "userdata" then
				const Meta = Getmetatable(Iterator) :: any
				const IterFunction = if Type(Meta) == "table" then Rawget(Meta, "__iter") else nil

				if IterFunction ~= nil then
					const Generator, State, Control = (IterFunction :: (any) -> (any, any, any))(Iterator)

					if Generator == nil then
						Error("attempt to call a nil value")
					end

					Stack[SlotA] = Generator
					Stack[SlotA + 1] = State
					Stack[SlotA + 2] = Control
				elseif Type(Meta) ~= "table" or Rawget(Meta, "__call") == nil then
					if Kind == "userdata" then
						Error(`attempt to iterate over a {Typeof(Iterator)} value`)
					end

					Stack[SlotA] = Next
					Stack[SlotA + 1] = Iterator
					Stack[SlotA + 2] = nil
				end
			else
				Error(`attempt to iterate over a {Typeof(Iterator)} value`)
			end

			return OnNext(Stack)
		end, Unlinked
	end

	return function(Stack: Registers): Handler?
		const Iterator = Stack[SlotA]
		const Kind = Type(Iterator)

		if Kind == "function" then
			return NextFn
		end

		if Strict then
			Error(`attempt to iterate over a {Kind} value`)
		end

		if Kind == "table" or Kind == "userdata" then
			const Meta = Getmetatable(Iterator) :: any
			const IterFunction = if Type(Meta) == "table" then Rawget(Meta, "__iter") else nil

			if IterFunction ~= nil then
				const Generator, State, Control = (IterFunction :: (any) -> (any, any, any))(Iterator)

				if Generator == nil then
					Error("attempt to call a nil value")
				end

				Stack[SlotA] = Generator
				Stack[SlotA + 1] = State
				Stack[SlotA + 2] = Control
			elseif Type(Meta) ~= "table" or Rawget(Meta, "__call") == nil then
				if Kind == "userdata" then
					Error(`attempt to iterate over a {Typeof(Iterator)} value`)
				end

				Stack[SlotA] = Next
				Stack[SlotA + 1] = Iterator
				Stack[SlotA + 2] = nil
			end
		else
			Error(`attempt to iterate over a {Typeof(Iterator)} value`)
		end

		return NextFn
	end, Link
end

-- Ipairs for setup over R(A): a verified ipairs over a plain table steps inline.
const function MakeForGPrepInext(Mode: number, A: number, OnNext: Handler, OnTarget: Handler): (Handler, Linker)
	local NextFn: Handler = OnNext

	const function Link(LinkedNext: Handler, LinkedTarget: Handler)
		NextFn = LinkedNext
	end

	const SlotA = A + RegisterBase + 1

	if Mode == 1 then --// chained
		return function(Stack: Registers): Handler?
			const Iterator = Stack[SlotA]

			--// like the reference VM's ipairs fast path, a verified ipairs loop over a table is marked for inline stepping
			if Iterator == Inext and Type(Stack[SlotA + 1]) == "table" and Getmetatable(Stack[SlotA + 1]) == nil and Stack[SlotA + 2] == 0 then
				Stack[SlotA] = IpairsStep

				return OnNext(Stack)
			elseif Type(Iterator) == "function" then
				return OnNext(Stack)
			end

			Error(`attempt to iterate over a {Type(Iterator)} value`)

			return OnNext(Stack)
		end, Unlinked
	end

	return function(Stack: Registers): Handler?
		const Iterator = Stack[SlotA]

		--// like the reference VM's ipairs fast path, a verified ipairs loop over a table is marked for inline stepping
		if Iterator == Inext and Type(Stack[SlotA + 1]) == "table" and Getmetatable(Stack[SlotA + 1]) == nil and Stack[SlotA + 2] == 0 then
			Stack[SlotA] = IpairsStep

			return NextFn
		elseif Type(Iterator) == "function" then
			return NextFn
		end

		Error(`attempt to iterate over a {Type(Iterator)} value`)

		return NextFn
	end, Link
end

local ForGLoopIpairsMaker: ((Mode: number, A: number, OnNext: Handler, OnTarget: Handler) -> (Handler, Linker))? = nil

const function LoadForGLoopIpairs(): (Mode: number, A: number, OnNext: Handler, OnTarget: Handler) -> (Handler, Linker)
	const Maker = ForGLoopIpairsMaker or require("./Variants/Control/ForGLoopIpairs")

	ForGLoopIpairsMaker = Maker

	return Maker
end

-- R(A+3), R(A+4) = the next index and value of R(A+1) after R(A+2), then jump back unless nil.
-- Baked copies (A < 32) load from Variants/Control on first use; other operands run the generic copy below.
const function MakeForGLoopIpairs(Mode: number, A: number, OnNext: Handler, OnTarget: Handler): (Handler, Linker)
	if A < 32 then
		return LoadForGLoopIpairs()(Mode, A, OnNext, OnTarget)
	end

	local NextFn: Handler = OnNext
	local TargetFn: Handler = OnTarget

	const function Link(LinkedNext: Handler, LinkedTarget: Handler)
		NextFn = LinkedNext
		TargetFn = LinkedTarget
	end

	const SlotA = A + RegisterBase + 1

	if Mode == 1 then --// fallthrough chained
		return function(Stack: Registers): Handler?
			const Iterator = Stack[SlotA]

			if Iterator == IpairsStep then
				const Index = Stack[SlotA + 2] + 1
				--// plain indexing equals inext's raw read on a table that had no metatable when the loop started
				const Value = Stack[SlotA + 1][Index]

				if Value ~= nil then
					Stack[SlotA + 2] = Index
					Stack[SlotA + 3] = Index
					Stack[SlotA + 4] = Value

					return TargetFn
				end

				return OnNext(Stack)
			end

			const Key, Value = Iterator(Stack[SlotA + 1], Stack[SlotA + 2])

			if Key ~= nil then
				Stack[SlotA + 2] = Key
				Stack[SlotA + 3] = Key
				Stack[SlotA + 4] = Value

				return TargetFn
			end

			return OnNext(Stack)
		end, Link
	end

	return function(Stack: Registers): Handler?
		const Iterator = Stack[SlotA]

		if Iterator == IpairsStep then
			const Index = Stack[SlotA + 2] + 1
			--// plain indexing equals inext's raw read on a table that had no metatable when the loop started
			const Value = Stack[SlotA + 1][Index]

			if Value ~= nil then
				Stack[SlotA + 2] = Index
				Stack[SlotA + 3] = Index
				Stack[SlotA + 4] = Value

				return TargetFn
			end

			return NextFn
		end

		const Key, Value = Iterator(Stack[SlotA + 1], Stack[SlotA + 2])

		if Key ~= nil then
			Stack[SlotA + 2] = Key
			Stack[SlotA + 3] = Key
			Stack[SlotA + 4] = Value

			return TargetFn
		end

		return NextFn
	end, Link
end

