		Stack[SlotA] = VectorLerp(Stack[SlotA + 1], Stack[SlotA + 2], Stack[SlotA + 3])

		return NextFn
	end, Link
end

const function Matches(Id: number, Value: any, Count: number, Results: number): boolean
	--// a builtin missing from the host (the integer library on Roblox) proves nothing
	if Value == nil then
		return false
	end

	if Id == 54 then
		return (Value == VectorCreate) and (Count == 2 or Count == 3) and Results <= 1
	end

	if Id == 78 then
		return (Value == VectorMagnitude) and (Count == 1) and Results <= 1
	end

	if Id == 79 then
		return (Value == VectorNormalize) and (Count == 1) and Results <= 1
	end

	if Id == 80 then
		return (Value == VectorCross) and (Count == 2) and Results <= 1
	end

	if Id == 81 then
		return (Value == VectorDot) and (Count == 2) and Results <= 1
	end

	if Id == 82 then
		return (Value == VectorFloor) and (Count == 1) and Results <= 1
	end

	if Id == 83 then
		return (Value == VectorCeil) and (Count == 1) and Results <= 1
	end

	if Id == 84 then
		return (Value == VectorAbs) and (Count == 1) and Results <= 1
	end

	if Id == 85 then
		return (Value == VectorSign) and (Count == 1) and Results <= 1
	end

	if Id == 86 then
		return (Value == VectorClamp) and (Count == 3) and Results <= 1
	end

	if Id == 87 then
		return (Value == VectorMin) and (Count == 2 or Count == 3) and Results <= 1
	end

	if Id == 88 then
		return (Value == VectorMax) and (Count == 2 or Count == 3) and Results <= 1
	end

	if Id == 90 then
		return (Value == VectorLerp) and (Count == 3) and Results <= 1
	end

	return false
end

