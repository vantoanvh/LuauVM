const function MakeFastMathIsnan1x1(Mode: number, A: number, OnNext: Handler, OnTarget: Handler): (Handler, Linker)
	local NextFn: Handler = OnNext

	const function Link(LinkedNext: Handler, LinkedTarget: Handler)
		NextFn = LinkedNext
	end

	const SlotA = A + RegisterBase + 1

	if Mode == 1 then --// chained
		return function(Stack: Registers): Handler?
			Stack[SlotA] = MathIsnan(Stack[SlotA + 1])

			return OnNext(Stack)
		end, Unlinked
	end

	return function(Stack: Registers): Handler?
		Stack[SlotA] = MathIsnan(Stack[SlotA + 1])

		return NextFn
	end, Link
end

