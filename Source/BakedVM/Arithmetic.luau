				Stack[SlotA] = Base * Base
			elseif K == 0.5 then
				Stack[SlotA] = MathSqrt(Base)
			elseif K == 3 then
				Stack[SlotA] = Base * Base * Base
			else
				Stack[SlotA] = Base ^ K
			end

			return OnNext(Stack)
		end, Unlinked
	end

	return function(Stack: Registers): Handler?
		const Base = Stack[SlotB]

		--// pow is slow, so the reference VM specializes ^2, ^0.5 and ^3 for numbers; results differ in the last digits
		if Type(Base) ~= "number" then
			Stack[SlotA] = Base ^ K
		elseif K == 2 then
			Stack[SlotA] = Base * Base
		elseif K == 0.5 then
			Stack[SlotA] = MathSqrt(Base)
		elseif K == 3 then
			Stack[SlotA] = Base * Base * Base
		else
			Stack[SlotA] = Base ^ K
		end

		return NextFn
	end, Link
end

