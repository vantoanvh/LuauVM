-- Picks the call handler family for an argument count (B - 1, or up to top when B is 0) and a result count (C - 1, or multiple when C is 0).
const function MakeCall(Mode: number, A: number, B: number, C: number, OnNext: Handler, OnTarget: Handler): (Handler, Linker)
	if B == 0 then
		if C == 0 then
			return Calls.MakeCallTopxMany(Mode, A, OnNext, OnTarget)
		elseif C == 1 then
			return Calls.MakeCallTopx0(Mode, A, OnNext, OnTarget)
		elseif C == 2 then
			return Calls.MakeCallTopx1(Mode, A, OnNext, OnTarget)
		elseif C == 3 then
			return Calls.MakeCallTopx2(Mode, A, OnNext, OnTarget)
		elseif C == 4 then
			return Calls.MakeCallTopx3(Mode, A, OnNext, OnTarget)
		end
	elseif B == 1 then
		if C == 0 then
			return Calls.MakeCall0xMany(Mode, A, OnNext, OnTarget)
		elseif C == 1 then
			return Calls.MakeCall0x0(Mode, A, OnNext, OnTarget)
		elseif C == 2 then
			return Calls.MakeCall0x1(Mode, A, OnNext, OnTarget)
		elseif C == 3 then
			return Calls.MakeCall0x2(Mode, A, OnNext, OnTarget)
		elseif C == 4 then
			return Calls.MakeCall0x3(Mode, A, OnNext, OnTarget)
		end
	elseif B == 2 then
		if C == 0 then
			return Calls.MakeCall1xMany(Mode, A, OnNext, OnTarget)
		elseif C == 1 then
			return Calls.MakeCall1x0(Mode, A, OnNext, OnTarget)
		elseif C == 2 then
			return Calls.MakeCall1x1(Mode, A, OnNext, OnTarget)
		elseif C == 3 then
			return Calls.MakeCall1x2(Mode, A, OnNext, OnTarget)
		elseif C == 4 then
			return Calls.MakeCall1x3(Mode, A, OnNext, OnTarget)
		end
	elseif B == 3 then
		if C == 0 then
			return Calls.MakeCall2xMany(Mode, A, OnNext, OnTarget)
		elseif C == 1 then
			return Calls.MakeCall2x0(Mode, A, OnNext, OnTarget)
		elseif C == 2 then
			return Calls.MakeCall2x1(Mode, A, OnNext, OnTarget)
		elseif C == 3 then
			return Calls.MakeCall2x2(Mode, A, OnNext, OnTarget)
		elseif C == 4 then
			return Calls.MakeCall2x3(Mode, A, OnNext, OnTarget)
		end
	elseif B == 4 then
		if C == 0 then
			return Calls.MakeCall3xMany(Mode, A, OnNext, OnTarget)
		elseif C == 1 then
			return Calls.MakeCall3x0(Mode, A, OnNext, OnTarget)
		elseif C == 2 then
			return Calls.MakeCall3x1(Mode, A, OnNext, OnTarget)
		elseif C == 3 then
			return Calls.MakeCall3x2(Mode, A, OnNext, OnTarget)
		elseif C == 4 then
			return Calls.MakeCall3x3(Mode, A, OnNext, OnTarget)
		end
	elseif B == 5 then
		if C == 0 then
			return Calls.MakeCall4xMany(Mode, A, OnNext, OnTarget)
		elseif C == 1 then
			return Calls.MakeCall4x0(Mode, A, OnNext, OnTarget)
		elseif C == 2 then
			return Calls.MakeCall4x1(Mode, A, OnNext, OnTarget)
		elseif C == 3 then
			return Calls.MakeCall4x2(Mode, A, OnNext, OnTarget)
		elseif C == 4 then
			return Calls.MakeCall4x3(Mode, A, OnNext, OnTarget)
		end
	elseif B == 6 then
		if C == 0 then
			return Calls.MakeCall5xMany(Mode, A, OnNext, OnTarget)
		elseif C == 1 then
			return Calls.MakeCall5x0(Mode, A, OnNext, OnTarget)
		elseif C == 2 then
			return Calls.MakeCall5x1(Mode, A, OnNext, OnTarget)
		elseif C == 3 then
			return Calls.MakeCall5x2(Mode, A, OnNext, OnTarget)
		elseif C == 4 then
			return Calls.MakeCall5x3(Mode, A, OnNext, OnTarget)
		end
	elseif B == 7 then
		if C == 0 then
			return Calls.MakeCall6xMany(Mode, A, OnNext, OnTarget)
		elseif C == 1 then
			return Calls.MakeCall6x0(Mode, A, OnNext, OnTarget)
		elseif C == 2 then
			return Calls.MakeCall6x1(Mode, A, OnNext, OnTarget)
		elseif C == 3 then
			return Calls.MakeCall6x2(Mode, A, OnNext, OnTarget)
		elseif C == 4 then
			return Calls.MakeCall6x3(Mode, A, OnNext, OnTarget)
		end
	end

	return Calls.MakeCallN(Mode, A, B, C, OnNext, OnTarget)
end

-- Picks the handler for a NAMECALL fused with its CALL: Count arguments after the object, and the CALL's C (results + 1, or 0).
const function MakeMethod(Mode: number, A: number, B: number, Method: any, Count: number, C: number, OnNext: Handler, OnTarget: Handler): (Handler, Linker)
	if Count == 0 then
		if C == 0 then
			return Methods.MakeMethod0xMany(Mode, A, B, Method, OnNext, OnTarget)
		elseif C == 1 then
			return Methods.MakeMethod0x0(Mode, A, B, Method, OnNext, OnTarget)
		elseif C == 2 then
			return Methods.MakeMethod0x1(Mode, A, B, Method, OnNext, OnTarget)
		elseif C == 3 then
			return Methods.MakeMethod0x2(Mode, A, B, Method, OnNext, OnTarget)
		else
			return Methods.MakeMethod0x3(Mode, A, B, Method, OnNext, OnTarget)
		end
	elseif Count == 1 then
		if C == 0 then
			return Methods.MakeMethod1xMany(Mode, A, B, Method, OnNext, OnTarget)
		elseif C == 1 then
			return Methods.MakeMethod1x0(Mode, A, B, Method, OnNext, OnTarget)
		elseif C == 2 then
			return Methods.MakeMethod1x1(Mode, A, B, Method, OnNext, OnTarget)
		elseif C == 3 then
			return Methods.MakeMethod1x2(Mode, A, B, Method, OnNext, OnTarget)
		else
			return Methods.MakeMethod1x3(Mode, A, B, Method, OnNext, OnTarget)
		end
	elseif Count == 2 then
		if C == 0 then
			return Methods.MakeMethod2xMany(Mode, A, B, Method, OnNext, OnTarget)
		elseif C == 1 then
			return Methods.MakeMethod2x0(Mode, A, B, Method, OnNext, OnTarget)
		elseif C == 2 then
			return Methods.MakeMethod2x1(Mode, A, B, Method, OnNext, OnTarget)
		elseif C == 3 then
			return Methods.MakeMethod2x2(Mode, A, B, Method, OnNext, OnTarget)
		else
			return Methods.MakeMethod2x3(Mode, A, B, Method, OnNext, OnTarget)
		end
	elseif Count == 3 then
		if C == 0 then
			return Methods.MakeMethod3xMany(Mode, A, B, Method, OnNext, OnTarget)
		elseif C == 1 then
			return Methods.MakeMethod3x0(Mode, A, B, Method, OnNext, OnTarget)
		elseif C == 2 then
			return Methods.MakeMethod3x1(Mode, A, B, Method, OnNext, OnTarget)
		elseif C == 3 then
			return Methods.MakeMethod3x2(Mode, A, B, Method, OnNext, OnTarget)
		else
			return Methods.MakeMethod3x3(Mode, A, B, Method, OnNext, OnTarget)
		end
	else
		if C == 0 then
			return Methods.MakeMethod4xMany(Mode, A, B, Method, OnNext, OnTarget)
		elseif C == 1 then
			return Methods.MakeMethod4x0(Mode, A, B, Method, OnNext, OnTarget)
		elseif C == 2 then
			return Methods.MakeMethod4x1(Mode, A, B, Method, OnNext, OnTarget)
		elseif C == 3 then
			return Methods.MakeMethod4x2(Mode, A, B, Method, OnNext, OnTarget)
		else
			return Methods.MakeMethod4x3(Mode, A, B, Method, OnNext, OnTarget)
		end
	end
end

