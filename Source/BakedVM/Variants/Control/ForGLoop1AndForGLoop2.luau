		end

		return function(Stack: Registers): Handler?
			const Key, Value = Stack[36](Stack[37], Stack[38])

			if Key ~= nil then
				Stack[38] = Key
				Stack[39] = Key
				Stack[40] = Value

				return TargetFn
			end

			return NextFn
		end, Link
	end

	--// R34, R35 = R31(R32, R33), then jump back unless R34 is nil
	if Mode == 1 then --// fallthrough chained
		return function(Stack: Registers): Handler?
			const Key, Value = Stack[37](Stack[38], Stack[39])

			if Key ~= nil then
				Stack[39] = Key
				Stack[40] = Key
				Stack[41] = Value

				return TargetFn
			end

			return OnNext(Stack)
		end, Link
	end

	return function(Stack: Registers): Handler?
		const Key, Value = Stack[37](Stack[38], Stack[39])

		if Key ~= nil then
			Stack[39] = Key
			Stack[40] = Key
			Stack[41] = Value

			return TargetFn
		end

		return NextFn
	end, Link
end

return {
	MakeForGLoop1 = MakeForGLoop1,
	MakeForGLoop2 = MakeForGLoop2,
}
