				return if Index <= Limit then TargetFn else OnNext(Stack)
			end, Link
		end

		if A < 27 then
			--// R28 += 1, then jump back while R28 <= Limit
			return function(Stack: Registers): Handler?
				const Index = Stack[34] + 1

				Stack[34] = Index

				return if Index <= Limit then TargetFn else OnNext(Stack)
			end, Link
		end

		--// R29 += 1, then jump back while R29 <= Limit
		return function(Stack: Registers): Handler?
			const Index = Stack[35] + 1

			Stack[35] = Index

			return if Index <= Limit then TargetFn else OnNext(Stack)
		end, Link
	end

	if A < 30 then
		if A < 29 then
			--// R30 += 1, then jump back while R30 <= Limit
			return function(Stack: Registers): Handler?
				const Index = Stack[36] + 1

				Stack[36] = Index

				return if Index <= Limit then TargetFn else OnNext(Stack)
			end, Link
		end

		--// R31 += 1, then jump back while R31 <= Limit
		return function(Stack: Registers): Handler?
			const Index = Stack[37] + 1

			Stack[37] = Index

			return if Index <= Limit then TargetFn else OnNext(Stack)
		end, Link
	end

	if A < 31 then
		--// R32 += 1, then jump back while R32 <= Limit
		return function(Stack: Registers): Handler?
			const Index = Stack[38] + 1

			Stack[38] = Index

			return if Index <= Limit then TargetFn else OnNext(Stack)
		end, Link
	end

	--// R33 += 1, then jump back while R33 <= Limit
	return function(Stack: Registers): Handler?
		const Index = Stack[39] + 1

		Stack[39] = Index

		return if Index <= Limit then TargetFn else OnNext(Stack)
	end, Link
end

return {
