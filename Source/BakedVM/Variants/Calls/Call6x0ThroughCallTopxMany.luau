					Stack[10], Stack[11], Stack[12] = Stack[10](TableUnpack(Stack, 11, Stack[5]))

					return OnNext(Stack)
				end, Unlinked
			end

			--// R5, R6, R7 = R5(R6, ..., top)
			return function(Stack: Registers): Handler?
				Stack[11], Stack[12], Stack[13] = Stack[11](TableUnpack(Stack, 12, Stack[5]))

				return OnNext(Stack)
			end, Unlinked
		end

		if A < 7 then
			--// R6, R7, R8 = R6(R7, ..., top)
			return function(Stack: Registers): Handler?
				Stack[12], Stack[13], Stack[14] = Stack[12](TableUnpack(Stack, 13, Stack[5]))

				return OnNext(Stack)
			end, Unlinked
		end

		--// R7, R8, R9 = R7(R8, ..., top)
		return function(Stack: Registers): Handler?
			Stack[13], Stack[14], Stack[15] = Stack[13](TableUnpack(Stack, 14, Stack[5]))

			return OnNext(Stack)
		end, Unlinked
	end

	if A < 12 then
		if A < 10 then
			if A < 9 then
				--// R8, R9, R10 = R8(R9, ..., top)
				return function(Stack: Registers): Handler?
					Stack[14], Stack[15], Stack[16] = Stack[14](TableUnpack(Stack, 15, Stack[5]))

					return OnNext(Stack)
				end, Unlinked
			end

			--// R9, R10, R11 = R9(R10, ..., top)
			return function(Stack: Registers): Handler?
				Stack[15], Stack[16], Stack[17] = Stack[15](TableUnpack(Stack, 16, Stack[5]))

				return OnNext(Stack)
			end, Unlinked
		end

		if A < 11 then
			--// R10, R11, R12 = R10(R11, ..., top)
			return function(Stack: Registers): Handler?
				Stack[16], Stack[17], Stack[18] = Stack[16](TableUnpack(Stack, 17, Stack[5]))

				return OnNext(Stack)
			end, Unlinked
		end

		--// R11, R12, R13 = R11(R12, ..., top)
		return function(Stack: Registers): Handler?
			Stack[17], Stack[18], Stack[19] = Stack[17](TableUnpack(Stack, 18, Stack[5]))

			return OnNext(Stack)
		end, Unlinked
	end

	if A < 14 then
		if A < 13 then
			--// R12, R13, R14 = R12(R13, ..., top)
			return function(Stack: Registers): Handler?
				Stack[18], Stack[19], Stack[20] = Stack[18](TableUnpack(Stack, 19, Stack[5]))

				return OnNext(Stack)
			end, Unlinked
		end

		--// R13, R14, R15 = R13(R14, ..., top)
		return function(Stack: Registers): Handler?
			Stack[19], Stack[20], Stack[21] = Stack[19](TableUnpack(Stack, 20, Stack[5]))

			return OnNext(Stack)
		end, Unlinked
	end

	if A < 15 then
		--// R14, R15, R16 = R14(R15, ..., top)
		return function(Stack: Registers): Handler?
			Stack[20], Stack[21], Stack[22] = Stack[20](TableUnpack(Stack, 21, Stack[5]))

			return OnNext(Stack)
		end, Unlinked
	end

	--// R15, R16, R17 = R15(R16, ..., top)
	return function(Stack: Registers): Handler?
		Stack[21], Stack[22], Stack[23] = Stack[21](TableUnpack(Stack, 22, Stack[5]))

		return OnNext(Stack)
	end, Unlinked
end

-- R(A), ... = R(A)(R(A+1), ..., top), keeping every result and setting top, baked for A < 16: one copy per operand combination.
const function MakeCallTopxMany(Mode: number, A: number, OnNext: Handler, OnTarget: Handler): (Handler, Linker)
	if A < 8 then
		if A < 4 then
			if A < 2 then
				if A < 1 then
					--// R0, ... = R0(R1, ..., top), keeping every result and setting top
					return function(Stack: Registers): Handler?
						Spread(Stack, 6, Stack[6](TableUnpack(Stack, 7, Stack[5])))

						return OnNext(Stack)
					end, Unlinked
				end

				--// R1, ... = R1(R2, ..., top), keeping every result and setting top
				return function(Stack: Registers): Handler?
					Spread(Stack, 7, Stack[7](TableUnpack(Stack, 8, Stack[5])))

					return OnNext(Stack)
				end, Unlinked
			end

			if A < 3 then
				--// R2, ... = R2(R3, ..., top), keeping every result and setting top
				return function(Stack: Registers): Handler?
					Spread(Stack, 8, Stack[8](TableUnpack(Stack, 9, Stack[5])))

					return OnNext(Stack)
				end, Unlinked
			end

			--// R3, ... = R3(R4, ..., top), keeping every result and setting top
			return function(Stack: Registers): Handler?
				Spread(Stack, 9, Stack[9](TableUnpack(Stack, 10, Stack[5])))

				return OnNext(Stack)
			end, Unlinked
		end

		if A < 6 then
			if A < 5 then
				--// R4, ... = R4(R5, ..., top), keeping every result and setting top
				return function(Stack: Registers): Handler?
					Spread(Stack, 10, Stack[10](TableUnpack(Stack, 11, Stack[5])))

					return OnNext(Stack)
				end, Unlinked
			end

			--// R5, ... = R5(R6, ..., top), keeping every result and setting top
			return function(Stack: Registers): Handler?
				Spread(Stack, 11, Stack[11](TableUnpack(Stack, 12, Stack[5])))

				return OnNext(Stack)
			end, Unlinked
		end

		if A < 7 then
			--// R6, ... = R6(R7, ..., top), keeping every result and setting top
			return function(Stack: Registers): Handler?
				Spread(Stack, 12, Stack[12](TableUnpack(Stack, 13, Stack[5])))

				return OnNext(Stack)
			end, Unlinked
		end

		--// R7, ... = R7(R8, ..., top), keeping every result and setting top
		return function(Stack: Registers): Handler?
			Spread(Stack, 13, Stack[13](TableUnpack(Stack, 14, Stack[5])))

			return OnNext(Stack)
		end, Unlinked
	end

	if A < 12 then
		if A < 10 then
			if A < 9 then
				--// R8, ... = R8(R9, ..., top), keeping every result and setting top
				return function(Stack: Registers): Handler?
					Spread(Stack, 14, Stack[14](TableUnpack(Stack, 15, Stack[5])))

					return OnNext(Stack)
				end, Unlinked
			end

			--// R9, ... = R9(R10, ..., top), keeping every result and setting top
			return function(Stack: Registers): Handler?
				Spread(Stack, 15, Stack[15](TableUnpack(Stack, 16, Stack[5])))

				return OnNext(Stack)
			end, Unlinked
		end

		if A < 11 then
			--// R10, ... = R10(R11, ..., top), keeping every result and setting top
			return function(Stack: Registers): Handler?
				Spread(Stack, 16, Stack[16](TableUnpack(Stack, 17, Stack[5])))

				return OnNext(Stack)
			end, Unlinked
		end

		--// R11, ... = R11(R12, ..., top), keeping every result and setting top
		return function(Stack: Registers): Handler?
			Spread(Stack, 17, Stack[17](TableUnpack(Stack, 18, Stack[5])))

			return OnNext(Stack)
		end, Unlinked
	end

	if A < 14 then
		if A < 13 then
			--// R12, ... = R12(R13, ..., top), keeping every result and setting top
			return function(Stack: Registers): Handler?
				Spread(Stack, 18, Stack[18](TableUnpack(Stack, 19, Stack[5])))

				return OnNext(Stack)
			end, Unlinked
		end

		--// R13, ... = R13(R14, ..., top), keeping every result and setting top
		return function(Stack: Registers): Handler?
			Spread(Stack, 19, Stack[19](TableUnpack(Stack, 20, Stack[5])))

			return OnNext(Stack)
		end, Unlinked
	end

	if A < 15 then
		--// R14, ... = R14(R15, ..., top), keeping every result and setting top
		return function(Stack: Registers): Handler?
			Spread(Stack, 20, Stack[20](TableUnpack(Stack, 21, Stack[5])))

			return OnNext(Stack)
		end, Unlinked
	end

	--// R15, ... = R15(R16, ..., top), keeping every result and setting top
	return function(Stack: Registers): Handler?
		Spread(Stack, 21, Stack[21](TableUnpack(Stack, 22, Stack[5])))

		return OnNext(Stack)
	end, Unlinked
end

return {
	MakeCall6x0 = MakeCall6x0,
	MakeCall6x1 = MakeCall6x1,
	MakeCall6x2 = MakeCall6x2,
	MakeCall6x3 = MakeCall6x3,
	MakeCall6xMany = MakeCall6xMany,
	MakeCallTopx0 = MakeCallTopx0,
	MakeCallTopx1 = MakeCallTopx1,
	MakeCallTopx2 = MakeCallTopx2,
	MakeCallTopx3 = MakeCallTopx3,
	MakeCallTopxMany = MakeCallTopxMany,
}
